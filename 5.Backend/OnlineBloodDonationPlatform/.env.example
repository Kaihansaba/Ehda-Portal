# Copy this file to .env (same folder as manage.py) and change the values.
# .env is git-ignored. Every setting is optional for local development.

# Long random string. Required when DJANGO_DEBUG is False.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# True for local development, False in production.
DJANGO_DEBUG=True

# Comma-separated host names allowed to serve the site (needed when DEBUG is False).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Real email (optional). Without these, emails are printed in the terminal.
# For Gmail, use an app password (Google account > Security > App passwords),
# never your normal password.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-address@gmail.com
