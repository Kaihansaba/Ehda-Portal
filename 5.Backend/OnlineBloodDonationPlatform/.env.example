# Ehda Portal settings.
# Copy this file to .env (same folder as manage.py) and change the values.
# .env is git-ignored: never commit it. Every setting is optional for local
# development; the comments say which ones a live site needs.
# Real environment variables always win over values in .env.


# --- Core ---------------------------------------------------------------

# Long random string. REQUIRED when DJANGO_DEBUG is False; placeholder
# values are refused. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# True for local development. False on a live site (shows the site's own
# 404/500 pages, turns on secure cookies, hides error details).
DJANGO_DEBUG=True

# Comma-separated host names the site answers to. REQUIRED when DEBUG is
# False. Example for PythonAnywhere: ehdaportal.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated full origins (with https://) allowed to submit forms.
# REQUIRED for a live HTTPS site. Example:
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://ehdaportal.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=


# --- HTTPS (only used when DJANGO_DEBUG is False) -------------------------

# Leave False on PythonAnywhere: its "Force HTTPS" switch does the redirect.
# Set True only on a host where Django itself must redirect HTTP to HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False

# HSTS: how long browsers should remember to use HTTPS only, in seconds.
# 0 = off. Turn it on only after HTTPS works (e.g. 3600, later 31536000);
# browsers remember it and can't be told to forget early.
DJANGO_SECURE_HSTS_SECONDS=0

# With HSTS on, also cover subdomains of the site's host name.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True


# --- Logging --------------------------------------------------------------

# WARNING shows errors and email failures in the server log. Use INFO or
# DEBUG for more detail while investigating a problem.
DJANGO_LOG_LEVEL=WARNING


# --- Email ----------------------------------------------------------------
# Without EMAIL_HOST_USER and EMAIL_HOST_PASSWORD, emails (notifications,
# password reset) are printed to the console / server log instead of sent.
# Setting both switches to SMTP. A failed email is logged and never breaks
# a page. PythonAnywhere's free tier blocks SMTP, so leave these empty there.
# For Gmail, use an app password (Google account > Security > App
# passwords), never your normal password.

# SMTP server, port and encryption.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# SMTP login. Both empty = console email.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Seconds to wait for the SMTP server before giving up.
EMAIL_TIMEOUT=10

# The "From" address on emails the site sends.
DEFAULT_FROM_EMAIL=webmaster@localhost

# Advanced: force a specific Django email backend, e.g.
#   django.core.mail.backends.console.EmailBackend
# Leave empty to choose automatically (console or safe SMTP).
EMAIL_BACKEND=
